import java.util.*;
public class abworkspace {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        String input=sc.nextLine();
      char s[] =input.toCharArray();
         int left=0;
        int right=s.length-1;
        while(left<right){
        char temp=s[left];
        s[left]=s[right];
        s[right]=temp;
       left++;
        right--;
        }
        System.out.print(new String(s));
        sc.close();
       }
    }
